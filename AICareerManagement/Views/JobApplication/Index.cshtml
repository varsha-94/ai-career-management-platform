
@model IEnumerable<AICareerManagement.Models.JobApplicationModel>

@{
    ViewBag.Title = "My Job Applications";

    var statuses = new[]
    {
        "Applied",
        "Interview",
        "Selected",
        "Rejected",
        "On Hold"
    };
}

<div class="container mt-4">

    <div class="clearfix">
        <div class="pull-left">
            <h2>My Job Applications</h2>
            <p class="text-muted">
                Search, filter and manage your job applications.
            </p>
        </div>

        <div class="pull-right">
            @Html.ActionLink(
                     "+ Add Application",
                     "Create",
                     "JobApplication",
                     null,
                     new { @class = "btn btn-primary" })
        </div>
    </div>

    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- Search and Filter -->
    @using (Html.BeginForm(
        "Index",
        "JobApplication",
        FormMethod.Get,
        new { @class = "form-inline", role = "search" }))
    {
        <div class="row" style="margin-bottom:20px;">

            <div class="col-md-5 col-sm-5">
                <input type="text"
                       name="searchTerm"
                       value="@ViewBag.SearchTerm"
                       class="form-control"
                       placeholder="Search company, job title..."
                       style="width:100%;" />
            </div>

            <div class="col-md-3 col-sm-3">
                @Html.DropDownList(
                         "applicationStatus",
                         new SelectList(
                             statuses,
                             ViewBag.ApplicationStatus
                         ),
                         "All Statuses",
                         new { @class = "form-control", style = "width:100%;" })
            </div>

            <div class="col-md-4 col-sm-4">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                @Html.ActionLink(
                         "Clear",
                         "Index",
                         null,
                         new { @class = "btn btn-default" })
            </div>

        </div>
    }

    <!-- Applications Table -->
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Company</th>
                        <th>Job Title</th>
                        <th>Job Description</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.CompanyName</strong>
                            </td>

                            <td>@item.JobTitle</td>

                            <td>
                                @(string.IsNullOrEmpty(item.JobDescription)
                                    ? "-"
                                    : (item.JobDescription.Length > 60
                                        ? item.JobDescription.Substring(0, 60) + "..."
                                        : item.JobDescription))
                            </td>

                            <td>
                                <span class="label label-info">
                                    @item.ApplicationStatus
                                </span>
                            </td>

                            <td>
                                @item.AppliedDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @Html.ActionLink(
                                         "Edit",
                                         "Edit",
                                         new { id = item.ApplicationId },
                                         new { @class = "btn btn-warning btn-xs" })

                                @using (Html.BeginForm(
                                    "Delete",
                                    "JobApplication",
                                    new { id = item.ApplicationId },
                                    FormMethod.Post,
                                    new
                                    {
                                        style = "display:inline;",
                                        onsubmit = "return confirm('Are you sure you want to delete this application?');"
                                    }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-xs">
                                        Delete
                                    </button>
                                }
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No job applications found.
            Try changing your search or filter, or add a new application.
        </div>
    }

    <p class="text-muted">
        Total matching applications:
        <strong>@(Model == null ? 0 : Model.Count())</strong>
    </p>

</div>
