
@model IEnumerable<AICareerManagement.Models.JobApplicationModel>

@{
    ViewBag.Title = "My Job Applications";
}

<div class="container mt-4">
    <h2>My Job Applications</h2>

    <p>
        @Html.ActionLink("Add New Application", "Create",
                 "JobApplication", null,
                 new { @class = "btn btn-primary" })
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Job Title</th>
                    <th>Status</th>
                    <th>Applied Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CompanyName</td>
                        <td>@item.JobTitle</td>
                        <td>@item.ApplicationStatus</td>
                        <td>@item.AppliedDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            @Html.ActionLink("Edit", "Edit",
                                     new { id = item.ApplicationId },
                                     new { @class = "btn btn-warning btn-sm" })

                            @using (Html.BeginForm("Delete",
                                "JobApplication",
                                new { id = item.ApplicationId },
                                FormMethod.Post,
                                new { onsubmit = "return confirm('Delete this application?');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">
            No job applications found. Add your first application!
        </div>
    }
</div>
