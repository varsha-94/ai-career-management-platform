
@model AICareerManagement.Models.JobApplicationModel

@{
    ViewBag.Title = "Add Job Application";
}

<div class="container mt-4">
    <h2>Add Job Application</h2>

    @using (Html.BeginForm("Create", "JobApplication",
        FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.CompanyName)
            @Html.TextBoxFor(m => m.CompanyName,
                     new { @class = "form-control", placeholder = "Company name" })
            @Html.ValidationMessageFor(m => m.CompanyName,
                     "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.JobTitle)
            @Html.TextBoxFor(m => m.JobTitle,
                     new { @class = "form-control", placeholder = "Job title" })
            @Html.ValidationMessageFor(m => m.JobTitle,
                     "", new { @class = "text-danger" })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.JobDescription)
            @Html.TextAreaFor(m => m.JobDescription,
                     new { @class = "form-control", rows = 4 })
        </div>

        <div class="form-group mb-3">
            @Html.LabelFor(m => m.ApplicationStatus)
            @Html.DropDownListFor(m => m.ApplicationStatus,
                     new SelectList(new[]
                     {
                    "Applied", "Interview", "Selected",
                    "Rejected", "On Hold"
                         }),
                     "Select Status",
                     new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.ApplicationStatus,
                     "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success">
            Save Application
        </button>

        @Html.ActionLink("Back", "Index", null,
                 new { @class = "btn btn-secondary" })
    }
</div>
